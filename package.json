{
  "name": "august-trading",
  "private": true,
  "version": "1.4.0",
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "22.23.3"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "description": "August Trading — a local-first AI trading work harness: one tool-driven seat, a reviewable journal, and a self-auditing learning loop.",
  "author": "August Trading",
  "repository": {
    "type": "git",
    "url": "https://github.com/Acepay25/august-3.5.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "probe:chip": "node scripts/chip-shot.cjs",
    "probe:census": "node scripts/surface-census.cjs",
    "probe:surfaces": "node scripts/surface-shots.cjs",
    "lint": "eslint . --max-warnings 370",
    "lint:loose": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:electron": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/sseParser.cjs",
    "electron": "wait-on tcp:3000 && electron .",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"npm run electron\"",
    "electron:build": "npm run build && electron-builder",
    "electron:release": "node scripts/release-is-ci-only.cjs",
    "boot-probe": "node scripts/boot-probe.cjs",
    "render-probe": "node scripts/render-probe.cjs",
    "check:contracts": "node scripts/check-contracts.cjs",
    "check:boundaries": "node scripts/check-boundaries.cjs",
    "installer-smoke": "node scripts/installer-smoke.cjs",
    "verify:signature": "node scripts/verify-release-signature.cjs",
    "replay:plans": "node scripts/replay-plans.cjs",
    "check:docs": "node scripts/check-docs.cjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-collapsible": "^1.1.18",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "idb": "8.0.0",
    "katex": "^0.18.7",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.26.0",
    "openai": "4.52.7",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "4.12.3",
    "recharts": "^3.5.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "technicalindicators": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^10.7.0",
    "js-yaml": "^4.3.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.2",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.3"
  },
  "build": {
    "artifactName": "August-Trading-Setup-${version}.${ext}",
    "appId": "com.august35.tradingapp",
    "productName": "August Trading",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "public/favicon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "August Trading"
    },
    "publish": {
      "provider": "github",
      "owner": "KILLER3UG",
      "repo": "augustTrading",
      "releaseType": "release"
    }
  }
}
